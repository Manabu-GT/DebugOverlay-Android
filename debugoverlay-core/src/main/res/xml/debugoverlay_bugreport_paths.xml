<?xml version="1.0" encoding="utf-8"?>
<!--
  FileProvider paths for bug report and crash record sharing.
  Bug reports are stored in the app's cache directory under "debugoverlay_bugreports/".
  Crash record exports are stored under "debugoverlay_crash_exports/".
-->
<paths>
  <cache-path
    name="debugoverlay_bugreports"
    path="debugoverlay_bugreports/" />
  <cache-path
    name="debugoverlay_crash_exports"
    path="debugoverlay_crash_exports/" />
</paths>
