<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- Normal permission for reading network state (No user approval required) -->
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

  <application>
    <activity
      android:name="com.ms.square.debugoverlay.internal.ui.DebugPanelActivity"
      android:theme="@style/debugoverlay_Theme.Transparent"
      android:exported="false"
      android:excludeFromRecents="true" />
  </application>


  <!--
    Root detection package queries (required for Android 11+ package visibility):
    - Only checks if these packages are installed, not whether root is actively used
    - Best-effort heuristic; rooted devices can hide these packages
    - No permission dialog shown to users (invisible to end user)
    - Used for debugging/diagnostics only, not security enforcement
  -->
  <queries>
    <package android:name="com.topjohnwu.magisk" />
    <package android:name="eu.chainfire.supersu" />
    <package android:name="com.noshufou.android.su" />
    <package android:name="com.koushikdutta.superuser" />
    <package android:name="com.zachspenner.zbksu" />
    <package android:name="com.thirdparty.superuser" />
    <package android:name="com.yellowes.su" />
  </queries>
</manifest>
